{
  "name": "alynt-drime-backups-dashboard",
  "version": "0.1.65",
  "private": true,
  "description": "Read-only central monitoring dashboard for Alynt Drime backup uploader sites.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "deploy": "bash deploy.sh",
    "lint": "npm run lint:php",
    "lint:php": "php ./vendor/bin/phpcs",
    "lint:fix": "php ./vendor/bin/phpcbf",
    "pot": "wp i18n make-pot . languages/alynt-drime-backups-dashboard.pot",
    "test:coverage": "php ./vendor/bin/phpunit --coverage-html=coverage/",
    "test": "php ./vendor/bin/phpunit"
  },
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}

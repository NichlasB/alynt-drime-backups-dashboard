{
  "name": "alynt-drime-backups-dashboard",
  "version": "0.1.8",
  "private": true,
  "description": "Read-only central monitoring dashboard for Alynt Drime backup uploader sites.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "deploy": "bash deploy.sh",
    "deploy:watch": "nodemon --watch . --ext php,js,css,html --ignore node_modules/ --ignore .git/ --ignore scripts/ --delay 2 --exec \"bash deploy.sh\"",
    "dev:all": "concurrently --names \"build,deploy\" --prefix-colors \"cyan,magenta\" \"npm run dev\" \"npm run deploy:watch\"",
    "lint": "npm run lint:php",
    "lint:php": "php ./vendor/bin/phpcs",
    "lint:fix": "php ./vendor/bin/phpcbf",
    "pot": "wp i18n make-pot . languages/alynt-drime-backups-dashboard.pot",
    "test:coverage": "php ./vendor/bin/phpunit --coverage-html=coverage/",
    "test": "php ./vendor/bin/phpunit"
  },
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.0"
  }
}
